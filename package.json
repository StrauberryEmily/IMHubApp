  "description": "Backend server for IMH Inventory Management Hub - handles password reset emails",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2-start": "pm2 start server.js --name 'IMH-Server' --max-memory-restart 200M",
    "pm2-stop": "pm2 stop IMH-Server",
    "pm2-restart": "pm2 restart IMH-Server",
    "pm2-status": "pm2 status",
    "pm2-logs": "pm2 logs IMH-Server"
