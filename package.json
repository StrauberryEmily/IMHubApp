    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.3",
    "pm2": "^5.3.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "pm2": "^5.3.0"
  }
